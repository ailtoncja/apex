# Configuração do servidor do Apex (variáveis de ambiente). Copie para o serviço de hospedagem; NUNCA commite os valores reais.

# Banco PostgreSQL. No Neon: Dashboard > Connection string. Sem isto o servidor sobe um banco embutido (só para desenvolvimento).
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Segredo que assina os tokens de login (mínimo 32 caracteres). Gere um com:  openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-mais-de-32-caracteres

# Endereço público do servidor (vai nos links dos e-mails de confirmar e redefinir senha).
PUBLIC_URL=https://api.seudominio.com

# E-mails (https://resend.com, plano grátis). Sem a chave, os e-mails só aparecem no log.
RESEND_API_KEY=
MAIL_FROM=Apex <contato@seudominio.com>

# Ligue se o servidor estiver atrás de um proxy/balanceador (Render, Fly, Cloudflare...), para o limite de tentativas ver o IP real.
TRUST_PROXY=true

# Porta (muitas hospedagens definem sozinhas).
PORT=8080
