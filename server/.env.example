# Configuração do servidor do Apex (variáveis de ambiente). Copie para o serviço de hospedagem; NUNCA commite os valores reais.

# Banco PostgreSQL. No Neon: Dashboard > Connection string. Sem isto o servidor sobe um banco embutido (só para desenvolvimento).
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Segredo que assina os tokens de login (mínimo 32 caracteres). Gere um com:  openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-mais-de-32-caracteres

# Endereço público do servidor (vai nos links dos e-mails de confirmar e redefinir senha).
PUBLIC_URL=https://api.seudominio.com

# E-mails (https://resend.com, plano grátis). Sem a chave, os e-mails só aparecem no log.
RESEND_API_KEY=
MAIL_FROM=Apex <contato@seudominio.com>

# E-mail GRÁTIS sem domínio (só vale se RESEND_API_KEY estiver vazio): um relay seu, no Google Apps Script ou na Vercel. Veja docs/email-relay/.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=

# Ligue se o servidor estiver atrás de um proxy/balanceador (Render, Fly, Cloudflare...), para o limite de tentativas ver o IP real.
TRUST_PROXY=true
# Quantos proxies (balanceador, CDN) ficam na frente do servidor: só as últimas N entradas do X-Forwarded-For valem. Na Render, 3.
TRUSTED_PROXY_HOPS=1
# Cabeçalho em que o CDN informa o IP do cliente (na Render, CF-Connecting-IP). Tem prioridade sobre o X-Forwarded-For.
CLIENT_IP_HEADER=

# Quem responde pelo serviço. Aparecem na Política de Privacidade e nos Termos (/privacy e /terms). Defina antes de abrir ao público.
CONTACT_EMAIL=contato@seudominio.com
OPERATOR_NAME=Seu Nome ou Nome da Empresa

# Link para baixar o app (só https), na página inicial do servidor. Se ficar vazio, usa a página de Releases do projeto no GitHub.
DOWNLOAD_URL=

# Proteções do banco grátis (valores padrão). Contas no total; contas novas e pedidos de senha por hora, por IP.
MAX_USERS=2000
REGISTER_LIMIT_PER_HOUR=20
MAIL_LIMIT_PER_HOUR=10

# Porta (muitas hospedagens definem sozinhas).
PORT=8080
